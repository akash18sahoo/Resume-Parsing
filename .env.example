# Copy this file to .env and fill in your values

# Gemini API Key - Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Max file size in MB
MAX_FILE_SIZE_MB=10
